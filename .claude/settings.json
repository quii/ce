{
  "permissions": {
    "allow": [
      "Bash(go tool mage *)",
      "Bash(go tool golangci-lint *)",
      "Bash(go tool go-mutesting *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-precommit.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  }
}

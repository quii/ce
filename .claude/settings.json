{
  "permissions": {
    "allow": [
      "Bash(go tool mage *)",
      "Bash(go tool golangci-lint *)",
      "Bash(go tool gremlins *)",
      "Bash(mkdir -p stories/*)",
      "Bash(mv stories/backlog/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * blame*)",
      "Bash(git -c core.pager=cat status*)",
      "Bash(git -c core.pager=cat diff*)",
      "Bash(git -c core.pager=cat log*)",
      "Bash(git -c core.pager=cat show*)",
      "Bash(git -c core.pager=cat blame*)",
      "Bash(git -c core.pager=cat -C * status*)",
      "Bash(git -c core.pager=cat -C * diff*)",
      "Bash(git -c core.pager=cat -C * log*)",
      "Bash(git -c core.pager=cat -C * show*)",
      "Bash(git -c core.pager=cat -C * blame*)",
      "Bash(shasum*)",
      "Bash(awk*)",
      "Bash(head*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-precommit.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  }
}
